---
import { getCollection } from "astro:content";
import SiteShell from "@/layouts/SiteShell.astro";
import MDXContent from "@/components/mdx/MDXContent.astro";
import { getRelatedSoftware } from "@/data/software";
import { isDraftVisible } from "@/utils/drafts";
import { loadEntry } from "@/utils/content-loader";
import { buildFeaturedPropagation } from "@/utils/featured-propagation";
import { SoftwareDetail, prepareSoftwareDetail } from "@semio-community/ecosystem-site-core";

export async function getStaticPaths() {
  const software = await getCollection("software", ({ data }) =>
    isDraftVisible(data.draft, data.sites),
  );
  return software.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;

const [featured, relatedSoftware, allPress, allAwards] = await Promise.all([
  buildFeaturedPropagation(),
  getRelatedSoftware(entry, 3),
  getCollection("press", ({ data }) => isDraftVisible(data.draft, data.sites)),
  getCollection("awards", ({ data }) => isDraftVisible(data.draft, data.sites)),
]);

const payload = await prepareSoftwareDetail({
  entry,
  loadEntry,
  featured,
  relatedSoftware,
  allPress,
  allAwards,
});

const meta = {
  title: `${entry.data.name} - Software Platform`,
  description: entry.data.description,
};
const ogImage = `/og/software/${entry.id}.png`;
---

<SiteShell
  title={meta.title}
  description={meta.description}
  ogImage={ogImage}
  containerClassName="max-w-5xl"
>
  <SoftwareDetail
    data={payload.data}
    organizationContributors={payload.contributors.organizations}
    peopleContributors={payload.contributors.people}
    relatedSoftware={payload.relatedSoftware}
    relatedPress={payload.relatedPress}
    awards={payload.awards}
    baseUrl={import.meta.env.BASE_URL}
  >
    {payload.shouldRenderBody && <MDXContent entry={entry} />}
  </SoftwareDetail>
</SiteShell>
