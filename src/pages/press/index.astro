---
import { getCollection } from "astro:content";
import SiteShell from "@/layouts/SiteShell.astro";
import { siteConfig } from "@/site.config";
import { isDraftVisible } from "@/utils/drafts";
import {
  AwardListElement,
  PressCard,
  preparePressIndexSections,
} from "@semio-community/ecosystem-site-core";

const meta = {
  title: "Press",
  description:
    "Announcements, publications, stories, and awards from across the Vizij ecosystem.",
};
const ogImage = "/og/press.png";

const allPress = await getCollection("press", ({ data }) =>
  isDraftVisible(data.draft, data.sites),
);
const allAwards = await getCollection("awards", ({ data }) =>
  isDraftVisible(data.draft, data.sites),
);

const { featured, announcements, publications, stories, awards } =
  preparePressIndexSections({
    allPress,
    allAwards,
    siteKey: siteConfig.siteKey,
  });
---

<SiteShell
  title={meta.title}
  description={meta.description}
  ogImage={ogImage}
  containerClassName="max-w-6xl"
>
  <section class="py-12">
    <header class="mb-10 max-w-3xl">
      <h1 class="text-3xl md:text-4xl font-bold mb-3">Press</h1>
      <p class="text-color-600 dark:text-color-400 text-lg">
        Announcements, publications, stories, and awards from across the
        ecosystem.
      </p>
    </header>

    {
      featured.length > 0 && (
        <section id="featured" class="mb-16 scroll-mt-20">
          <header class="mb-6">
            <h2 class="text-2xl font-semibold mb-1">Featured</h2>
            <p class="text-sm text-color-600 dark:text-color-400">
              Highlighted stories.
            </p>
          </header>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {featured.map((entry) => (
              <PressCard pressId={entry.id} data={entry.data as any} />
            ))}
          </div>
        </section>
      )
    }

    {
      announcements.length > 0 && (
        <section id="announcements" class="mb-16 scroll-mt-20">
          <header class="mb-6">
            <h2 class="text-2xl font-semibold mb-1">Announcements</h2>
            <p class="text-sm text-color-600 dark:text-color-400">
              Releases, notices, and updates.
            </p>
          </header>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {announcements.map((entry) => (
              <PressCard pressId={entry.id} data={entry.data as any} />
            ))}
          </div>
        </section>
      )
    }

    {
      publications.length > 0 && (
        <section id="publications" class="mb-16 scroll-mt-20">
          <header class="mb-6">
            <h2 class="text-2xl font-semibold mb-1">Publications</h2>
            <p class="text-sm text-color-600 dark:text-color-400">
              Papers, preprints, whitepapers, datasets, and other published
              works from across the ecosystem.
            </p>
          </header>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {publications.map((entry) => (
              <PressCard pressId={entry.id} data={entry.data as any} />
            ))}
          </div>
        </section>
      )
    }

    {
      stories.length > 0 && (
        <section id="stories" class="mb-16 scroll-mt-20">
          <header class="mb-6">
            <h2 class="text-2xl font-semibold mb-1">Stories</h2>
            <p class="text-sm text-color-600 dark:text-color-400">
              Longer-form articles from across the ecosystem.
            </p>
          </header>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {stories.map((entry) => (
              <PressCard pressId={entry.id} data={entry.data as any} />
            ))}
          </div>
        </section>
      )
    }

    {
      awards.length > 0 && (
        <section id="awards" class="scroll-mt-20">
          <header class="mb-6">
            <h2 class="text-2xl font-semibold mb-1">Awards</h2>
            <p class="text-sm text-color-600 dark:text-color-400">
              External recognition received by people, projects, and
              publications across the ecosystem.
            </p>
          </header>
          <div class="space-y-2 max-w-3xl">
            {awards.map((entry) => (
              <AwardListElement
                awardId={entry.id}
                data={entry.data as any}
                className="w-full"
              />
            ))}
          </div>
        </section>
      )
    }

    {
      featured.length === 0 &&
        announcements.length === 0 &&
        publications.length === 0 &&
        stories.length === 0 &&
        awards.length === 0 && (
          <p class="text-color-600 dark:text-color-400">
            No press entries yet.
          </p>
        )
    }
  </section>
</SiteShell>
