---
import { type CollectionEntry, getCollection } from "astro:content";
import SiteShell from "@/layouts/SiteShell.astro";
import MDXContent from "@/components/mdx/MDXContent.astro";
import { getAllOrganizations } from "@/data/organizations";
import { getAllHardware } from "@/data/hardware";
import { getAllSoftware } from "@/data/software";
import { getPeopleByOrganization } from "@/data/people";
import { getResearchByOrganization } from "@/data/research";

import { siteConfig } from "@/site.config";
import { isDraftVisible } from "@/utils/drafts";
import { buildFeaturedPropagation } from "@/utils/featured-propagation";
import {
  OrganizationDetail,
  filterHomeOrganization,
  prepareOrganizationDetail,
} from "@semio-community/ecosystem-site-core";

export async function getStaticPaths() {
  const organizations = await getCollection("organizations", ({ data }) =>
    isDraftVisible(data.draft, data.sites),
  );
  const partners = filterHomeOrganization(
    organizations.filter((org) => org.data.isPartner),
    siteConfig,
  );
  return partners.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"organizations"> };

const [
  featured,
  allOrganizations,
  research,
  allHardware,
  allSoftware,
  affiliatedPeople,
  allPress,
  allAwards,
] = await Promise.all([
  buildFeaturedPropagation(),
  getAllOrganizations(),
  getResearchByOrganization(entry.id),
  getAllHardware(),
  getAllSoftware(),
  getPeopleByOrganization(entry.id),
  getCollection("press", ({ data }) => isDraftVisible(data.draft, data.sites)),
  getCollection("awards", ({ data }) => isDraftVisible(data.draft, data.sites)),
]);

const payload = prepareOrganizationDetail({
  entry,
  featured,
  allOrganizations,
  research,
  allHardware,
  allSoftware,
  allPress,
  allAwards,
  affiliatedPeople,
  siteKey: siteConfig.siteKey,
});

const meta = {
  title: `${entry.data.name} - Partner Organization`,
  description: entry.data.description,
};
const ogImage = `/og/organizations/${entry.id}.png`;
---

<SiteShell
  title={meta.title}
  description={meta.description}
  ogImage={ogImage}
  containerClassName="max-w-5xl"
>
  <OrganizationDetail
    data={payload.data}
    relatedContent={payload.relatedContent}
    relatedOrganizations={payload.relatedOrganizations}
    awardsReceived={payload.awardsReceived}
    awardsGranted={payload.awardsGranted}
    keyContacts={payload.keyContacts}
    baseUrl={import.meta.env.BASE_URL}
  >
    {payload.shouldRenderBody && <MDXContent entry={entry} />}
  </OrganizationDetail>
</SiteShell>
