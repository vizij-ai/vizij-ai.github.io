---
import { getCollection } from "astro:content";
import SiteShell from "@/layouts/SiteShell.astro";
import MDXContent from "@/components/mdx/MDXContent.astro";
import { getAllEvents } from "@/data/events";
import { isDraftVisible } from "@/utils/drafts";
import { buildFeaturedPropagation } from "@/utils/featured-propagation";
import {
  EventDetail,
  prepareEventDetail,
  type RelatedItem,
} from "@semio-community/ecosystem-site-core";

export async function getStaticPaths() {
  const events = await getCollection("events", ({ data }) =>
    isDraftVisible(data.draft, data.sites),
  );
  return events.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;

const [featured, allEvents] = await Promise.all([
  buildFeaturedPropagation(),
  getAllEvents(),
]);

const payload = prepareEventDetail({ entry, allEvents, featured });

const meta = {
  title: `${payload.data.name} - Event`,
  description: payload.data.description,
};
const ogImage = `/og/events/${entry.id}.png`;
---

<SiteShell
  title={meta.title}
  description={meta.description}
  ogImage={ogImage}
  containerClassName="max-w-5xl"
>
  <EventDetail
    data={payload.data}
    relatedEvents={payload.relatedEvents as RelatedItem[]}
    baseUrl={import.meta.env.BASE_URL}
  >
    {payload.shouldRenderBody && <MDXContent entry={entry} />}
  </EventDetail>
</SiteShell>
