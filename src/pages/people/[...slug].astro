---
import { type CollectionEntry, getCollection } from "astro:content";
import SiteShell from "@/layouts/SiteShell.astro";
import MDXContent from "@/components/mdx/MDXContent.astro";
import { getAllHardware } from "@/data/hardware";
import { getAllResearch } from "@/data/research";
import { getAllSoftware } from "@/data/software";
import { getPeopleByExpertise, getPeopleByOrganization } from "@/data/people";
import { siteConfig } from "@/site.config";
import { isDraftVisible } from "@/utils/drafts";
import { loadEntry } from "@/utils/content-loader";
import { buildFeaturedPropagation } from "@/utils/featured-propagation";
import {
  PersonDetail,
  preparePersonDetail,
} from "@semio-community/ecosystem-site-core";

export async function getStaticPaths() {
  const people = await getCollection("people", ({ data }) =>
    isDraftVisible(data.draft, data.sites),
  );
  return people.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"people"> };

const [
  featured,
  allResearch,
  allHardware,
  allSoftware,
  allPress,
  allAwards,
  allOrganizationsUnfiltered,
] = await Promise.all([
  buildFeaturedPropagation(),
  getAllResearch(),
  getAllHardware(),
  getAllSoftware(),
  getCollection("press", ({ data }) => isDraftVisible(data.draft, data.sites)),
  getCollection("awards", ({ data }) => isDraftVisible(data.draft, data.sites)),
  getCollection("organizations"),
]);

const payload = await preparePersonDetail({
  entry,
  loadEntry,
  featured,
  allResearch,
  allHardware,
  allSoftware,
  allPress,
  allAwards,
  allOrganizationsUnfiltered,
  peopleByExpertise: getPeopleByExpertise,
  peopleByOrganization: getPeopleByOrganization,
  homeOrganizationId: siteConfig.homeOrganizationId,
});

const meta = {
  title: `${payload.fullName} - Contributor Profile`,
  description: entry.data.bio || `Profile of ${payload.fullName}`,
};
const ogImage = `/og/people/${entry.id}.png`;
---

<SiteShell
  title={meta.title}
  description={meta.description}
  ogImage={ogImage}
  containerClassName="max-w-5xl"
>
  <PersonDetail
    data={payload.data}
    fullName={payload.fullName}
    badges={payload.badges}
    currentAffiliations={payload.currentAffiliations}
    pastAffiliations={payload.pastAffiliations}
    relatedContent={payload.relatedContent}
    relatedPeople={payload.relatedPeople}
    awards={payload.awards}
    baseUrl={import.meta.env.BASE_URL}
    homeOrganizationId={siteConfig.homeOrganizationId}
    orgDisplayLookup={payload.orgDisplayLookup}
    suppressOrganizationPage={siteConfig.suppressOrganizationPage}
  >
    {payload.shouldRenderBody && <MDXContent entry={entry} />}
  </PersonDetail>
</SiteShell>
