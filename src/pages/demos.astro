---
// NOTE: `client:only` islands do not reliably emit CSS in Astro production builds.
// Keep stylesheet linked explicitly until the demos page no longer relies on client-only hydration.
import showcaseStylesUrl from "@/react-pages/showcase/styles.css?url";
import ShowcasePage from "@/react-pages/showcase/ShowcasePage";
import BaseHead from "@/components/BaseHead.astro";
import SiteShell from "@/layouts/SiteShell.astro";

const meta = {
  title: "Vizij Demos",
  description: "Interactive Vizij demos.",
};
---

<html
  class="overflow-x-hidden grid scroll-pt-18 scroll-smooth font-sans text-text text-xl md:text-base antialiased"
  lang="en"
>
  <head>
    <BaseHead
      title={meta.title}
      description={meta.description}
      ogImage="/og/home.png"
    />
    <link rel="stylesheet" href={showcaseStylesUrl} />
  </head>
  <body class="relative min-h-screen w-full bg-surface">
    <SiteShell noPaddingTop containerClassName="max-w-full">
      <ShowcasePage client:only="react" />
    </SiteShell>
  </body>
</html>
