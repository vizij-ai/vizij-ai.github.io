---
import { getCollection } from "astro:content";
import SiteShell from "@/layouts/SiteShell.astro";
import MDXContent from "@/components/mdx/MDXContent.astro";
import { getRelatedHardware } from "@/data/hardware";
import { isDraftVisible } from "@/utils/drafts";
import { loadEntry } from "@/utils/content-loader";
import { buildFeaturedPropagation } from "@/utils/featured-propagation";
import { HardwareDetail, prepareHardwareDetail } from "@semio-community/ecosystem-site-core";

export async function getStaticPaths() {
  const hardware = await getCollection("hardware", ({ data }) =>
    isDraftVisible(data.draft, data.sites),
  );
  return hardware.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;

const [featured, related, allPress, allAwards] = await Promise.all([
  buildFeaturedPropagation(),
  getRelatedHardware(entry, 3),
  getCollection("press", ({ data }) => isDraftVisible(data.draft, data.sites)),
  getCollection("awards", ({ data }) => isDraftVisible(data.draft, data.sites)),
]);

const payload = await prepareHardwareDetail({
  entry,
  loadEntry,
  featured,
  related,
  allPress,
  allAwards,
});

const meta = {
  title: `${entry.data.name} - Hardware Platform`,
  description: entry.data.description,
};
const ogImage = `/og/hardware/${entry.id}.png`;
---

<SiteShell
  title={meta.title}
  description={meta.description}
  ogImage={ogImage}
  containerClassName="max-w-5xl"
>
  <HardwareDetail
    data={payload.data}
    organizationContributors={payload.contributors.organizations}
    peopleContributors={payload.contributors.people}
    relatedHardware={payload.related}
    relatedPress={payload.relatedPress}
    awards={payload.awards}
    baseUrl={import.meta.env.BASE_URL}
  >
    {payload.shouldRenderBody && <MDXContent entry={entry} />}
  </HardwareDetail>
</SiteShell>
