---
import { type CollectionEntry, getCollection } from "astro:content";
import SiteShell from "@/layouts/SiteShell.astro";
import MDXContent from "@/components/mdx/MDXContent.astro";
import { getFormattedAuthors } from "@/data/people";
import { getRelatedResearch } from "@/data/research";
import { isDraftVisible } from "@/utils/drafts";
import { loadEntry } from "@/utils/content-loader";
import { buildFeaturedPropagation } from "@/utils/featured-propagation";
import {
  ResearchDetail,
  prepareResearchDetail,
} from "@semio-community/ecosystem-site-core";

export async function getStaticPaths() {
  const researchEntries = await getCollection("research", ({ data }) =>
    isDraftVisible(data.draft, data.sites),
  );
  return researchEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"research"> };

const [featured, relatedResearch, allPress, allAwards] = await Promise.all([
  buildFeaturedPropagation(),
  getRelatedResearch(entry, 3),
  getCollection("press", ({ data }) => isDraftVisible(data.draft, data.sites)),
  getCollection("awards", ({ data }) => isDraftVisible(data.draft, data.sites)),
]);

const payload = await prepareResearchDetail({
  entry,
  loadEntry,
  featured,
  relatedResearch,
  allPress,
  allAwards,
});

const authorsSubtitle = await getFormattedAuthors(entry.data.contributors ?? []);

const meta = {
  title: `${entry.data.title} - Research Study`,
  description: entry.data.description,
};
const ogImage = `/og/research/${entry.id}.png`;
---

<SiteShell
  title={meta.title}
  description={meta.description}
  ogImage={ogImage}
  containerClassName="max-w-5xl"
>
  <ResearchDetail
    data={payload.data}
    authors={payload.authors}
    authorsSubtitle={authorsSubtitle}
    organizationLinks={payload.organizationLinks}
    relatedHardware={payload.relatedHardware}
    relatedSoftware={payload.relatedSoftware}
    relatedResearch={payload.relatedResearch}
    relatedPress={payload.relatedPress}
    relatedPublications={payload.relatedPublications}
    awards={payload.awards}
    baseUrl={import.meta.env.BASE_URL}
  >
    {payload.shouldRenderBody && <MDXContent entry={entry} />}
  </ResearchDetail>
</SiteShell>
