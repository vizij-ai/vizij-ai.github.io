---
import { render as renderContent } from "astro:content";
import {
  type MDXComponentMap,
  mergeMDXComponents,
} from "@semio-community/ecosystem-site-core";

// biome-ignore lint/suspicious/noExplicitAny: Astro content render result is untyped
type RenderedContent = { Content: any };
type RenderableEntry = { render: () => Promise<RenderedContent> };

interface Props {
  /**
   * A content collection entry returned from `getEntry` or `getCollection`.
   * Must expose a `render()` function.
   */
  entry: unknown;
  /**
   * Optional per-page overrides or additions to the shared MDX components map.
   */
  components?: Partial<MDXComponentMap>;
  /**
   * Optional rendering variant. Guidebook pages use custom chrome and should
   * not inherit generic prose resets that flatten list and table semantics.
   */
  variant?: "default" | "guidebook";
}

const { entry, components, variant = "default" } = Astro.props as Props;
// Prefer the entry's render method (MDX); fall back to astro:content render helper.
const { Content } =
  (await (entry as RenderableEntry)?.render?.()) ??
  // biome-ignore lint/suspicious/noExplicitAny: entry type from getEntry/getCollection is not statically typed here
  (await renderContent(entry as any));
const componentMap = mergeMDXComponents(components);
const contentClass =
  variant === "guidebook"
    ? "mdx-content mdx-content--guidebook max-w-none text-color-800 leading-7 md:leading-8"
    : "mdx-content prose prose-lg dark:prose-invert max-w-none text-color-800 leading-7 md:leading-8";
---

<div class={contentClass}>
  <Content components={componentMap} />
</div>

<style is:global>
  .mdx-content--guidebook {
    --guidebook-heading: #211b16;
    --guidebook-body: #312a25;
    --guidebook-body-muted: #3f372f;
    --guidebook-blockquote-bg: linear-gradient(
      180deg,
      rgba(255, 159, 64, 0.08),
      rgba(255, 159, 64, 0.03)
    );
    --guidebook-inline-code-border: rgba(22, 23, 26, 0.08);
    --guidebook-inline-code-bg: rgba(22, 23, 26, 0.05);
    --guidebook-inline-code-color: #9a3412;
    --guidebook-code-bg: #16171a;
    --guidebook-code-border: rgba(34, 34, 37, 0.1);
    --guidebook-table-border: rgba(34, 34, 37, 0.12);
    --guidebook-table-bg: rgba(255, 255, 255, 0.8);
    --guidebook-table-head-bg: linear-gradient(
      180deg,
      rgba(239, 225, 205, 0.88),
      rgba(247, 241, 231, 0.9)
    );
    --guidebook-table-row-alt: rgba(247, 241, 231, 0.46);
    --guidebook-th: #8f4e14;
    --guidebook-figure-border: rgba(34, 34, 37, 0.1);
    --guidebook-figure-bg: rgba(255, 253, 248, 0.96);
    --guidebook-figure-media-bg: linear-gradient(
      180deg,
      rgba(247, 241, 231, 0.7),
      rgba(255, 253, 248, 0.94)
    );
    --guidebook-caption-bg: rgba(247, 241, 231, 0.66);
    --guidebook-caption-border: rgba(22, 23, 26, 0.08);
    --guidebook-caption: #6b625a;
    --guidebook-rule: rgba(22, 23, 26, 0.12);
    color: var(--guidebook-body);
  }

  :root[data-theme="dark"] .mdx-content--guidebook {
    --guidebook-heading: #f4ede3;
    --guidebook-body: #e5dccf;
    --guidebook-body-muted: #d0c4b5;
    --guidebook-blockquote-bg: linear-gradient(
      180deg,
      rgba(240, 179, 107, 0.12),
      rgba(240, 179, 107, 0.04)
    );
    --guidebook-inline-code-border: rgba(255, 255, 255, 0.1);
    --guidebook-inline-code-bg: rgba(255, 255, 255, 0.06);
    --guidebook-inline-code-color: #ffbf8a;
    --guidebook-code-bg: #101317;
    --guidebook-code-border: rgba(255, 255, 255, 0.1);
    --guidebook-table-border: rgba(255, 255, 255, 0.12);
    --guidebook-table-bg: rgba(23, 27, 34, 0.9);
    --guidebook-table-head-bg: linear-gradient(
      180deg,
      rgba(36, 39, 47, 0.96),
      rgba(25, 28, 35, 0.96)
    );
    --guidebook-table-row-alt: rgba(255, 255, 255, 0.03);
    --guidebook-th: #f0b36b;
    --guidebook-figure-border: rgba(255, 255, 255, 0.1);
    --guidebook-figure-bg: rgba(23, 27, 34, 0.92);
    --guidebook-figure-media-bg: linear-gradient(
      180deg,
      rgba(34, 38, 45, 0.92),
      rgba(16, 19, 24, 0.98)
    );
    --guidebook-caption-bg: rgba(18, 21, 27, 0.92);
    --guidebook-caption-border: rgba(255, 255, 255, 0.08);
    --guidebook-caption: #bbb2a7;
    --guidebook-rule: rgba(255, 255, 255, 0.12);
  }

  .mdx-content--guidebook :where(h2, h3, h4) {
    color: var(--guidebook-heading);
    letter-spacing: -0.015em;
  }

  .mdx-content--guidebook h2 {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: clamp(1.85rem, 3vw, 2.35rem);
    line-height: 1.08;
  }

  .mdx-content--guidebook h3 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    line-height: 1.15;
  }

  .mdx-content--guidebook h4 {
    margin-top: 1.5rem;
    margin-bottom: 0.65rem;
    font-size: 1.125rem;
    line-height: 1.3;
  }

  .mdx-content--guidebook p {
    margin-block: 1rem;
    color: var(--guidebook-body-muted);
    line-height: 1.9;
  }

  .mdx-content--guidebook a {
    color: hsl(var(--theme-accent-three));
    text-decoration-line: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .mdx-content--guidebook a:hover {
    color: hsl(var(--theme-accent-two));
  }

  .mdx-content--guidebook ul,
  .mdx-content--guidebook ol {
    margin-block: 1.15rem;
    padding-left: 1.6rem;
    color: var(--guidebook-body-muted);
    list-style-position: outside;
  }

  .mdx-content--guidebook ul {
    list-style: disc;
  }

  .mdx-content--guidebook ol {
    list-style: decimal;
  }

  .mdx-content--guidebook ul ul {
    list-style-type: circle;
  }

  .mdx-content--guidebook ul ul ul {
    list-style-type: square;
  }

  .mdx-content--guidebook ol ol {
    list-style-type: lower-alpha;
  }

  .mdx-content--guidebook li {
    margin-block: 0.45rem;
    padding-left: 0.25rem;
    line-height: 1.85;
  }

  .mdx-content--guidebook li > p {
    margin-block: 0.2rem;
  }

  .mdx-content--guidebook li > ul,
  .mdx-content--guidebook li > ol {
    margin-top: 0.7rem;
    margin-bottom: 0.1rem;
  }

  .mdx-content--guidebook blockquote {
    margin-block: 1.75rem;
    border-left: 4px solid hsl(var(--theme-accent-one) / 0.72);
    border-radius: 0 1rem 1rem 0;
    background: var(--guidebook-blockquote-bg);
    padding: 1rem 1.15rem;
    color: var(--guidebook-body);
  }

  .mdx-content--guidebook :not(pre) > code {
    border: 1px solid var(--guidebook-inline-code-border);
    border-radius: 0.6rem;
    background: var(--guidebook-inline-code-bg);
    padding: 0.16rem 0.42rem;
    font-size: 0.92em;
    color: var(--guidebook-inline-code-color);
  }

  .mdx-content--guidebook [data-rehype-pretty-code-figure] {
    margin-block: 1.5rem;
    overflow: hidden;
    border: 1px solid rgba(22, 23, 26, 0.08);
    border-radius: 1.1rem;
    background: var(--guidebook-code-bg);
    box-shadow: 0 20px 48px -32px rgba(24, 24, 27, 0.5);
  }

  .mdx-content--guidebook [data-rehype-pretty-code-figure] pre {
    margin: 0;
    overflow-x: auto;
    padding: 1rem 1.15rem;
    background: transparent !important;
    border: 0;
  }

  .mdx-content--guidebook [data-rehype-pretty-code-figure] code {
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 0.92rem;
    line-height: 1.75;
  }

  .mdx-content--guidebook pre:not(.guidebook-mermaid):not([data-language]) {
    margin-block: 1.5rem;
    overflow-x: auto;
    border: 1px solid var(--guidebook-code-border);
    border-radius: 1rem;
    background: var(--guidebook-code-bg);
    padding: 1rem 1.15rem;
    color: #f7f4ed;
  }

  .mdx-content--guidebook
    pre:not(.guidebook-mermaid):not([data-language])
    code {
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
  }

  .mdx-content--guidebook .guidebook-mermaid {
    margin-block: 1.75rem;
    overflow: auto;
    border: 1px solid var(--guidebook-figure-border);
    border-radius: 1.25rem;
    background: var(--guidebook-figure-media-bg);
    padding: 1rem;
    box-shadow: 0 24px 64px -38px rgba(24, 24, 27, 0.28);
    white-space: pre;
  }

  .mdx-content--guidebook .guidebook-mermaid[data-processed="true"] {
    white-space: normal;
    padding: 1rem;
  }

  .mdx-content--guidebook .guidebook-mermaid svg {
    display: block;
    height: auto;
    min-width: min(100%, 34rem);
    margin-inline: auto;
    overflow: visible;
  }

  .mdx-content--guidebook table {
    display: block;
    width: max-content;
    min-width: 100%;
    max-width: 100%;
    margin-block: 1.75rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--guidebook-table-border);
    border-radius: 1.15rem;
    border-collapse: separate;
    border-spacing: 0;
    background: var(--guidebook-table-bg);
    box-shadow: 0 20px 48px -34px rgba(24, 24, 27, 0.28);
  }

  .mdx-content--guidebook thead {
    background: var(--guidebook-table-head-bg);
  }

  .mdx-content--guidebook th,
  .mdx-content--guidebook td {
    min-width: 10rem;
    padding: 0.95rem 1rem;
    border-right: 1px solid var(--guidebook-table-border);
    border-bottom: 1px solid var(--guidebook-table-border);
    vertical-align: top;
    text-align: left;
  }

  .mdx-content--guidebook th {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--guidebook-th);
  }

  .mdx-content--guidebook td {
    font-size: 0.97rem;
    line-height: 1.75;
    color: var(--guidebook-body);
  }

  .mdx-content--guidebook tr > :last-child {
    border-right: 0;
  }

  .mdx-content--guidebook tbody tr:last-child > * {
    border-bottom: 0;
  }

  .mdx-content--guidebook tbody tr:nth-child(even) {
    background: var(--guidebook-table-row-alt);
  }

  .mdx-content--guidebook figure:not([data-rehype-pretty-code-figure]),
  .mdx-content--guidebook .guidebook-media {
    margin-block: 1.75rem;
    overflow: hidden;
    border: 1px solid var(--guidebook-figure-border);
    border-radius: 1.25rem;
    background: var(--guidebook-figure-bg);
    box-shadow: 0 24px 64px -38px rgba(24, 24, 27, 0.32);
  }

  .mdx-content--guidebook figure:not([data-rehype-pretty-code-figure]) img,
  .mdx-content--guidebook .guidebook-media img,
  .mdx-content--guidebook .guidebook-media video {
    display: block;
    width: 100%;
    height: auto;
    max-height: min(72vh, 54rem);
    object-fit: contain;
    background: var(--guidebook-figure-media-bg);
  }

  .mdx-content--guidebook figcaption,
  .mdx-content--guidebook .guidebook-media figcaption {
    border-top: 1px solid var(--guidebook-caption-border);
    background: var(--guidebook-caption-bg);
    padding: 0.9rem 1rem 1rem;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--guidebook-caption);
  }

  .mdx-content--guidebook hr {
    margin-block: 2.4rem;
    border: 0;
    border-top: 1px solid var(--guidebook-rule);
  }

  @media (max-width: 50rem) {
    .mdx-content--guidebook table {
      font-size: 0.92rem;
    }

    .mdx-content--guidebook th,
    .mdx-content--guidebook td {
      min-width: 8.5rem;
      padding: 0.8rem 0.85rem;
    }

    .mdx-content--guidebook .guidebook-mermaid {
      padding: 0.85rem;
    }

    .mdx-content--guidebook [data-rehype-pretty-code-figure] pre,
    .mdx-content--guidebook pre:not(.guidebook-mermaid):not([data-language]) {
      padding-inline: 0.9rem;
    }
  }
</style>
