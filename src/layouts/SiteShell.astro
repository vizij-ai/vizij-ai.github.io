---
import "@/lib/register-icons";
import { getCollection } from "astro:content";
import BaseHead from "@/components/BaseHead.astro";
import ParallaxHexBackground from "@/components/background/ParallaxHexBackground";
import Footer from "@/components/layout/Footer";
import Header from "@/components/layout/Header";
import SkipLink from "@/components/layout/SkipLink";
import ThemeProvider from "@/components/theme/ThemeProvider";
import { menuLinks, siteConfig } from "@/site.config";
import { buildNavCollections } from "@semio-community/ecosystem-site-core";
import { buildFeaturedPropagation } from "@/utils/featured-propagation";
import { isDraftVisible } from "@/utils/drafts";
import type { SiteMeta } from "@/types";

export interface Props extends SiteMeta {
  containerClassName?: string;
}

const {
  // SiteMeta props — forwarded to BaseHead
  title,
  description,
  ogImage,
  articleDate,
  // Layout props
  containerClassName,
} = Astro.props as Props;

// The parallax hex background is a site-wide branding element driven by
// `siteConfig.parallaxBackground` — not a per-page prop. Present =
// render on every page (with optional tuning fields); absent = never.
// vizij omits the config key, so the background never renders here.
const parallaxBackground = siteConfig.parallaxBackground;

// Compute the press/award propagation set once and feed it (along
// with our draft-aware collection loaders) to the shared
// `buildNavCollections` helper. It walks featured sections in
// `menuLinks`, auto-fills with recency-ranked propagated entries,
// filters the home org when its detail page is suppressed, and
// resolves virtual fields (e.g. `affiliationLabel`) via the projector
// registry. See `nav-collections-builder.ts` in site-core for the
// full pipeline.
const featuredPropagation = await buildFeaturedPropagation();
const navCollections = await buildNavCollections({
  menuLinks,
  siteConfig,
  featuredPropagation,
  loadCollection: (key) =>
    getCollection(key, ({ data }) => isDraftVisible(data.draft, data.sites)),
  loadOrganizations: () => getCollection("organizations"),
});
---

<!doctype html>
<html
  class="overflow-x-hidden grid scroll-pt-18 scroll-smooth font-sans text-text text-xl md:text-base antialiased"
  lang={siteConfig.lang}
>
  <head>
    <BaseHead
      title={title}
      description={description}
      ogImage={ogImage}
      articleDate={articleDate}
    />
  </head>
  <body class="relative min-h-screen w-full bg-surface">
    <ThemeProvider />
    <SkipLink />
    <Header
      client:load
      currentPath={Astro.url.pathname}
      navCollections={navCollections}
    />

    {
      parallaxBackground && (
        <ParallaxHexBackground
          client:only="react"
          count={parallaxBackground.count}
          seed={parallaxBackground.seed}
          verticalSpanVh={parallaxBackground.verticalSpanVh}
          horizontalRangeVw={parallaxBackground.horizontalRangeVw}
          palette={parallaxBackground.palette}
          opacity={parallaxBackground.opacity}
          className={parallaxBackground.className}
        />
      )
    }

    <div class="relative flex min-h-screen w-full flex-col">
      <div class="relative flex min-h-screen w-full flex-1 m-auto max-w-6xl">
        <div
          id="container"
          class={`relative m-auto max-w-4xl grow w-full min-w-0 ${containerClassName || ""}`}
        >
          <div
            class="m-auto grid grid-cols-1 min-h-screen grid-rows-[1fr_auto] px-4 md:px-8 w-full min-w-0 pt-18"
          >
            <main id="main" class="relative grow" data-pagefind-body>
              <slot />
            </main>
            <Footer />
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
