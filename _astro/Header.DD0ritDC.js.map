        "eyebrow": "Stage 1",
        "title": "Guide",
        "description": "Get oriented, choose a learning path, and know when to switch from overview pages to implementation references.",
        "href": "/docs/getting-started/",
        "implementation": "Docs source overview",
        "outcome": "After this page, you should be able to choose the right learning path for your goal, pick the right depth, and know when to switch from overview pages to repo-local implementation docs."
      },
      {
        "eyebrow": "Stage 2",
        "title": "System Mental Model",
        "description": "Understand the stable Vizij layers: authored assets, runtime control, integration surfaces, and deployment surfaces.",
        "href": "/docs/architecture/",
        "implementation": "Guidebook introduction bucket",
        "outcome": "After this page, you should be able to explain the major parts of Vizij, how authored assets and runtime control relate, and which conceptual contracts stay stable as a face moves from authoring into integration and deployment."
      },
      {
        "eyebrow": "Stage 3",
        "title": "Renderer Data Model",
        "description": "Understand the typed input model, path semantics, and visible runtime behavior behind the first maintained interactions.",
        "href": "/docs/renderer-data-model/",
        "implementation": "Runtime React package",
        "outcome": "After this page, you should be able to explain what a Vizij runtime input is, how it relates to typed paths and values, and how visible behavior on a face maps to a more stable runtime meaning underneath."
      },
      {
        "eyebrow": "Stage 4",
        "title": "Rigging and Control Model",
        "description": "Learn the standard control vocabulary, path families, and portable control abstractions behind public-facing rig behavior.",
        "href": "/docs/rigging-and-control-model/",
        "implementation": "Renderer and rigging reference",
        "outcome": "After this page, you should be able to read common Vizij control paths, distinguish standard controls from pose-weight paths, and connect visible face behavior to the runtime values being written underneath it."
      },
      {
        "eyebrow": "Stage 5",
        "title": "Animation Model",
        "description": "Understand how animation authoring fits the broader Vizij workflow before you move into runtime playback and richer motion behavior.",
        "href": "/docs/animation-model/",
        "implementation": "Animation, integration, and deployment reference",
        "outcome": "After this page, you should be able to explain what an animation is in Vizij, what a clip, track, and keyframe mean in the current authoring model, and how playback state and transport help you preview authored motion before export."
      },
      {
        "eyebrow": "Stage 6",
        "title": "Deployment Model",
        "description": "Compare browser and standalone delivery, operator expectations, and the deployment tradeoffs behind the maintained tutorials.",
        "href": "/docs/deployment-model/",
        "implementation": "Standalone app",
        "outcome": "After this page, you should be able to explain the operational shape of the first Vizij deployment endpoint: what is running, who controls it, what signals move through it, and what counts as a healthy operator path."
      }
