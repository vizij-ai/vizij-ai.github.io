      {
        "eyebrow": "Stage 2",
        "title": "Renderer Data Model",
        "description": "Use the first maintained runtime interactions to make path writes, cause and effect, and visible control semantics concrete.",
        "href": "/tutorials/renderer-data-model/",
        "implementation": "Control bucket reference",
        "outcome": "After this page, you should be able to use the maintained fullscreen tutorial to trigger two different kinds of control, explain how their behavior differs, and connect each visible interaction to the code that stages it."
      },
      {
        "eyebrow": "Stage 3",
        "title": "Authoring",
        "description": "Take the lowest-friction authoring path first: tweak a maintained face, validate the visible change, and carry that proof into the next tutorial step.",
        "href": "/tutorials/authoring/",
        "implementation": "vizij-authoring",
        "outcome": "After this page, you should be able to open a maintained preset face in vizij-authoring, make one small visible change to the loaded face, and explain why that already counts as real customization work."
      },
      {
        "eyebrow": "Stage 4",
        "title": "Rigging And Control",
        "description": "Follow the deeper customization pathway through authoring, control structure, export discipline, and validation against a real runtime surface.",
